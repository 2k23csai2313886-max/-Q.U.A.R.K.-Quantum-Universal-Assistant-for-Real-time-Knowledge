# ─────────────────────────────────────────────────────────────
# Q.U.A.R.K. — environment
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your key.
#   cp .env.local.example .env.local
#
# Get a key (free tier available):  https://aistudio.google.com/apikey
#
# IMPORTANT — why this is safe:
#   * `.env.local` is git-ignored (see .gitignore). It is never committed.
#   * GEMINI_API_KEY has NO `NEXT_PUBLIC_` prefix, so Next.js only exposes it
#     to the Node/serverless runtime. It is read in exactly one place:
#     app/api/chat/route.js. It cannot appear in the browser bundle.
#   * On Vercel you set the same name under
#     Project → Settings → Environment Variables (Production + Preview + Development).
# ─────────────────────────────────────────────────────────────

GEMINI_API_KEY=your_api_key_here

# Model ID. Current stable options (Sept 2026):
#   gemini-2.5-flash      <- default. Free tier, fast, reliable function calling.
#   gemini-3.8-flash      <- newest stable Flash. Best quality/cost balance.
#   gemini-3.5-flash-lite <- cheapest, highest throughput.
#   gemini-3.1-pro-preview<- strongest reasoning, slower + pricier.
GEMINI_MODEL=gemini-2.5-flash

# Gemini REST endpoint. Leave as-is unless you are on Vertex AI.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Response budget. Thinking models count reasoning tokens against this, so
# 2048 (the old default) could return an EMPTY answer on a heavy-thinking turn.
QUARK_MAX_OUTPUT_TOKENS=8192

# Internal-reasoning budget. 0 disables thinking on gemini-2.5-flash/-lite
# (fastest + cheapest for a HUD assistant). gemini-2.5-pro floors at 128.
# gemini-3.* ignores this and uses thinkingLevel=LOW instead.
QUARK_THINKING_BUDGET=0

# Safety valve: max model round-trips per user turn (tool-call loop).
QUARK_MAX_TOOL_ROUNDS=6

# Per-request timeout for the upstream Gemini call, in milliseconds.
QUARK_UPSTREAM_TIMEOUT_MS=45000

# Optional: reject requests whose Origin is not one of these (comma-separated).
# Recommended on Vercel so nobody can drive your key from their own site.
# e.g. QUARK_ALLOWED_ORIGINS=https://quark.vercel.app,http://localhost:3000
QUARK_ALLOWED_ORIGINS=

# Optional: crude per-IP rate limit (requests per minute). 0 disables.
QUARK_RATE_LIMIT_PER_MIN=20

# ─────────────────────────────────────────────────────────────
# PER-TURN TOOL BUDGET (matters most on free tiers)
# ─────────────────────────────────────────────────────────────
# Declaring all 36 tools costs ~3,900 tokens of fixed overhead on EVERY round
# of the tool loop. Free tiers are capped per minute, not just per day:
#   Groq llama-3.1-8b-instant   6K tokens/min
#   Groq openai/gpt-oss-*       8K tokens/min
#   Groq llama-3.3-70b         12K tokens/min
# So the proxy declares only the tools this turn could plausibly use
# (~600 tokens for a typical question) and rebuilds the system prompt from the
# same subset. Tools already called in the conversation are always kept.
QUARK_TOOL_BUDGET=14
# Set to 1 to declare all 36 tools every turn (debugging only).
QUARK_SEND_ALL_TOOLS=0

# ─────────────────────────────────────────────────────────────
# PROVIDER SELECTION + AUTOMATIC FALLBACK
# ─────────────────────────────────────────────────────────────
# Two protocols are supported: "gemini" and "openai" (any OpenAI-compatible
# host — Groq, OpenRouter, Cerebras, Mistral, Ollama, LM Studio, llama.cpp).
# If the primary returns 429 (quota) or 5xx, the request is retried on the
# fallback automatically; the user never sees a raw quota error.
# See LOCAL_LLM.md for a full comparison of free options.
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openai

# ── OpenAI-compatible credentials ─────────────────────────────
# Defaults point at Groq's free tier. Key (no card): https://console.groq.com/keys
#
# Pick the model by tool support AND tokens-per-minute, not just quality —
# Q.U.A.R.K. is an agent, so the model MUST support local function calling:
#   llama-3.3-70b-versatile   12K TPM ·  100K/day · tools + parallel  <- default
#   openai/gpt-oss-120b        8K TPM ·  200K/day · tools, no parallel
#   openai/gpt-oss-20b         8K TPM ·  200K/day · tools, no parallel
#   llama-3.1-8b-instant       6K TPM ·  500K/day · tools + parallel (weakest)
#   meta-llama/llama-4-scout   30K TPM ·  500K/day · NO local tool calling ✗
#   groq/compound              70K TPM ·  250/day  · NO local tool calling ✗
# The last two look attractive on paper but cannot drive the 36 tools.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_MAX_TOKENS=2048

# Local runtimes (Option B in LOCAL_LLM.md):
#   Ollama     OPENAI_BASE_URL=http://127.0.0.1:11434/v1  OPENAI_MODEL=qwen3:4b
#   LM Studio  OPENAI_BASE_URL=http://127.0.0.1:1234/v1
#   llama.cpp  OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_API_KEY may be any non-empty string for these — they ignore it.
